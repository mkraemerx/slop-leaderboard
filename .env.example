# GitHub OAuth (used by FR-07)
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:8000/auth/callback

# Org whose members get access (optional)
GITHUB_ORG=your-org-name

# Platform API token for participant-repo discovery (scopes: repo, read:org)
GITHUB_TOKEN=ghp_...

# Template repository. Participant repos are clones of it, discovered via the
# template owner's organisation. Set at startup (seeded only when no template
# exists yet) or via the UI on the Repositories page.
ROOT_REPO_URL=https://github.com/your-org/your-template

# Repos in the org to skip during discovery (comma-separated repo names). The
# template itself and any is_template repo are excluded automatically; use this
# for infrastructure repos (build images, shared config, …).
DISCOVERY_EXCLUDE=training-configs,training-image

# Session signing key — generate with: uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_strong_random_value

# Optional
SYNC_INTERVAL_MINUTES=60
DATA_DIR=./data

# Logging verbosity. Default INFO logs only startup, errors, and
# meaningful state changes. DEBUG adds per-fork analysis lines and tick
# heartbeats — useful when debugging the scheduler.
LOG_LEVEL=INFO
