# GitHub OAuth (used by FR-07)
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:8000/auth/callback

# Org whose members get access (optional)
GITHUB_ORG=your-org-name

# Platform API token for fork discovery (scopes: repo, read:org)
GITHUB_TOKEN=ghp_...

# Root repository (configured at startup; can also be set via UI later)
ROOT_REPO_URL=https://github.com/your-org/your-root-repo

# Session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_strong_random_value

# Optional
SYNC_INTERVAL_MINUTES=60
DATA_DIR=./data
